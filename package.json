{
  "name": "app-factory",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "new-app": "node scripts/new-app.mjs",
    "dev:hub": "pnpm --filter hub dev",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "lint": "stylelint \"apps/**/*.css\" \"templates/**/*.css\" \"packages/design-tokens/src/**/*.css\" && node scripts/check-hardcoded.mjs && node scripts/check-theme.mjs"
  },
  "devDependencies": {
    "stylelint": "^17.16.0"
  }
}
