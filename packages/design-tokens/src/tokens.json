{
  "$comment": "デザイントークンの唯一の元データ。primitive(素の値) → semantic(役割) → component(部品) の3層。画面や部品は semantic と component だけを参照する。{gray.50} はプリミティブ、{color.primary} などはセマンティックへの参照。{\"mix\": [\"primary\", \"black\"], \"amount\": 12} は primary に black を 12% 混ぜた色 (oklab) で、primary を上書きすると自動で追従する。",
  "primitive": {
    "color": {
      "gray": {
        "0": "#FFFFFF",
        "50": "#F7F6F3",
        "100": "#EFEDE8",
        "200": "#E2DFD8",
        "400": "#A09D96",
        "600": "#6B6862",
        "700": "#34343A",
        "800": "#26262A",
        "850": "#1C1C1E",
        "900": "#1C1B19",
        "950": "#121212"
      },
      "blue": {
        "400": "#7C8CFF",
        "500": "#3D5AFE",
        "900": "#0E1033"
      },
      "orange": {
        "300": "#FF9A7F",
        "500": "#FF7A59",
        "950": "#2B1405"
      },
      "green": {
        "400": "#3CC584",
        "600": "#1F9D63"
      },
      "yellow": {
        "400": "#E6AE2E",
        "600": "#C98A00"
      },
      "red": {
        "400": "#FF6B6B",
        "600": "#D93A3A"
      }
    }
  },
  "semantic": {
    "color": {
      "light": {
        "background": "{gray.50}",
        "surface": "{gray.0}",
        "surface-muted": "{gray.100}",
        "text": "{gray.900}",
        "text-muted": "{gray.600}",
        "border": "{gray.200}",
        "primary": "{blue.500}",
        "primary-hover": {
          "mix": [
            "primary",
            "black"
          ],
          "amount": 12
        },
        "primary-pressed": {
          "mix": [
            "primary",
            "black"
          ],
          "amount": 24
        },
        "primary-soft": {
          "mix": [
            "surface",
            "primary"
          ],
          "amount": 12
        },
        "on-primary": "{gray.0}",
        "accent": "{orange.500}",
        "on-accent": "{orange.950}",
        "success": "{green.600}",
        "warning": "{yellow.600}",
        "danger": "{red.600}"
      },
      "dark": {
        "background": "{gray.950}",
        "surface": "{gray.850}",
        "surface-muted": "{gray.800}",
        "text": "{gray.50}",
        "text-muted": "{gray.400}",
        "border": "{gray.700}",
        "primary": "{blue.400}",
        "primary-hover": {
          "mix": [
            "primary",
            "white"
          ],
          "amount": 12
        },
        "primary-pressed": {
          "mix": [
            "primary",
            "white"
          ],
          "amount": 24
        },
        "primary-soft": {
          "mix": [
            "surface",
            "primary"
          ],
          "amount": 16
        },
        "on-primary": "{blue.900}",
        "accent": "{orange.300}",
        "on-accent": "{orange.950}",
        "success": "{green.400}",
        "warning": "{yellow.400}",
        "danger": "{red.400}"
      }
    },
    "space": {
      "1": 4,
      "2": 8,
      "3": 12,
      "4": 16,
      "5": 20,
      "6": 24,
      "7": 28,
      "8": 32,
      "9": 36,
      "10": 40
    },
    "font-family": {
      "base": "'Noto Sans JP', system-ui, -apple-system, 'Segoe UI', sans-serif",
      "mono": "ui-monospace, 'SFMono-Regular', Menlo, monospace"
    },
    "font-size": {
      "xs": 12,
      "sm": 14,
      "md": 16,
      "lg": 18,
      "xl": 24,
      "2xl": 32
    },
    "font-weight": {
      "regular": "400",
      "medium": "500",
      "bold": "700"
    },
    "line-height": {
      "body": 1.6,
      "heading": 1.25
    },
    "radius": {
      "sm": 6,
      "md": 12,
      "lg": 20,
      "full": 9999
    },
    "size": {
      "touch-min": 44
    },
    "shadow": {
      "card": {
        "y": 1,
        "blur": 3,
        "opacity": 0.08
      },
      "sheet": {
        "y": 8,
        "blur": 24,
        "opacity": 0.12
      }
    },
    "motion": {
      "fast": 150,
      "normal": 250
    },
    "ease": {
      "standard": "cubic-bezier(0.2, 0, 0, 1)"
    }
  },
  "component": {
    "button": {
      "bg": "{color.primary}",
      "bg-hover": "{color.primary-hover}",
      "bg-pressed": "{color.primary-pressed}",
      "text": "{color.on-primary}",
      "radius": "{radius.full}",
      "padding-x": "{space.6}",
      "padding-y": "{space.3}",
      "min-height": "{size.touch-min}"
    },
    "card": {
      "bg": "{color.surface}",
      "border": "{color.border}",
      "radius": "{radius.lg}",
      "shadow": "{shadow.card}",
      "padding": "{space.6}"
    },
    "chip": {
      "bg": "{color.surface}",
      "bg-selected": "{color.primary}",
      "text": "{color.text-muted}",
      "text-selected": "{color.on-primary}",
      "border": "{color.border}",
      "radius": "{radius.full}",
      "min-height": "{size.touch-min}"
    }
  }
}
